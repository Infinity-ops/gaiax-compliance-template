{
  "@context": [
    "https://registry.lab.gaia-x.eu/v1-staging/api/trusted-shape-registry/v1/shapes/jsonld/serviceoffering"
  ],
  "type": "gx:ServiceOffering",
  "id": "https://{domain}/.well-known/service-offering-{offering_id}.json",
  "gx:name": "{offering_name}",
  "gx:description": "{offering_description}",
  "gx:providedBy": {
    "id": "https://{domain}/.well-known/participant.json"
  },
  "gx:policy": {
    "id": "https://{domain}/.well-known/policy.json"
  },
  "gx:termsAndConditions": {
    "id": "https://{domain}/.well-known/tnc.json"
  },
  "gx:dataAccountExport": {
    "gx:requestType": "{offering_data_account_export.request_type}",
    "gx:accessType": "{offering_data_account_export.access_type}",
    "gx:formatType": "{offering_data_account_export.format}"
  },
  "gx:dataResourcesProduced": {offering_produces_resources}
}
